# =========================================================
# .gitignore — projet-segmentation-clients
# =========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Environment (uv) ----------
# Keep pyproject.toml and uv.lock in Git: they guarantee reproducibility
.venv/
venv/
env/
.python-version.local

# ---------- Secrets / local config ----------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---------- Jupyter notebooks ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ---------- Data ----------
# Datasets are not versioned; keep the folders with a .gitkeep file
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---------- Models ----------
# Serialized pipelines are regenerated by the pipeline
models/*.joblib
models/*.pkl
!models/.gitkeep

# ---------- MLflow ----------
mlruns/*
mlartifacts/
!mlruns/.gitkeep
mlflow.db

# ---------- Airflow (bonus) ----------
airflow/logs/
dags/__pycache__/
logs/
airflow.db
airflow.cfg
airflow-webserver.pid
standalone_admin_password.txt

# ---------- Generated reports ----------
# Uncomment if figures should not be versioned
# reports/figures/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db